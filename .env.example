# ==============================================================================
# MELAYURVEDA CRM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORK
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4100
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3010

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (DOCKER LOCAL DEV ONLY)
# ------------------------------------------------------------------------------
# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_USER=melayurveda_user
POSTGRES_PASSWORD=melayurveda_dev_pass_change_in_prod
POSTGRES_DB=melayurveda_crm
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Prisma Database Connection String
DATABASE_URL=postgresql://melayurveda_user:melayurveda_dev_pass_change_in_prod@127.0.0.1:5433/melayurveda_crm?schema=public

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Argon2id + JWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_melayurveda_2026_super_secure
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_melayurveda_2026_rotation_secure
JWT_REFRESH_EXPIRATION=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER ADMIN SEED CREDENTIALS (FIRST-TIME BOOTSTRAP ONLY)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@melayurveda.com
INITIAL_ADMIN_PASSWORD=Melayurveda@Admin2026!
INITIAL_ADMIN_FIRST_NAME=Super
INITIAL_ADMIN_LAST_NAME=Admin
INITIAL_ADMIN_PHONE=9876543210

# ------------------------------------------------------------------------------
# 5. FRONTEND CONNECTIVITY (NEXT.JS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_APP_NAME="Melayurveda CRM"
NEXT_PUBLIC_COMPANY_NAME="MELAYURVEDA INDIA PVT. LTD."
