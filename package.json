{
  "name": "melayurveda-crm-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Ayurvedic CRM Monorepo for MELAYURVEDA INDIA PVT. LTD.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "test": "npm run test --workspaces",
    "test:e2e:system": "ts-node -P apps/backend/tsconfig.build.json apps/backend/test/full-system-e2e.ts",
    "test:e2e:ui": "playwright test --config=apps/frontend/playwright.config.ts",
    "lint": "npm run lint --workspaces",
    "docker:db:up": "docker compose up -d postgres",
    "docker:db:down": "docker compose down",
    "docker:db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
