# ==============================================================================
# MELAYURVEDA BACKEND - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================

NODE_ENV=production
PORT=4100
API_PREFIX=/api/v1
CORS_ORIGIN=https://crm.melayurveda.com

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connection_limit=20&pool_timeout=30

JWT_ACCESS_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET_64_CHARS
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=REPLACE_WITH_ROTATION_ENTROPY_SECRET_64_CHARS
JWT_REFRESH_EXPIRATION=7d

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
