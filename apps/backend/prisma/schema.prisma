datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & ACCESS CONTROL
// ==========================================

enum RoleType {
  SUPER_ADMIN
  SALESPERSON
  PENDING_REVIEWER
  APPROVAL_OFFICER
  MANAGEMENT
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  employeeCode       String           @unique @db.VarChar(50)
  email              String           @unique @db.VarChar(255)
  passwordHash       String           @db.VarChar(255)
  firstName          String           @db.VarChar(100)
  lastName           String           @db.VarChar(100)
  phoneNumber        String           @db.VarChar(20)
  role               RoleType
  isActive           Boolean          @default(true)
  isAcceptingLeads   Boolean          @default(true)
  lastLoginAt        DateTime?        @db.Timestamptz
  createdAt          DateTime         @default(now()) @db.Timestamptz
  updatedAt          DateTime         @updatedAt @db.Timestamptz

  sessions           UserSession[]
  refreshTokens      RefreshToken[]
  assignedLeads      Lead[]           @relation("AssignedLeads")
  createdLeads       Lead[]           @relation("CreatedLeads")
  assignmentsGiven   LeadAssignment[] @relation("AssignmentsGiven")
  assignmentsReceived LeadAssignment[] @relation("AssignmentsReceived")
  callLogs           CallLog[]
  followUps          FollowUp[]
  pendingReviews     PendingReview[]  @relation("ReviewerPendingReviews")
  approvalRequests   ApprovalRequest[] @relation("OfficerApprovals")
  auditLogs          AuditLog[]
  ordersCreated      Order[]          @relation("OrdersCreated")

  @@index([role, isActive])
  @@index([employeeCode])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  ipAddress    String    @db.VarChar(45)
  userAgent    String    @db.VarChar(500)
  isActive     Boolean   @default(true)
  lastActiveAt DateTime  @default(now()) @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_sessions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  isRevoked   Boolean   @default(false)
  expiresAt   DateTime  @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

// ==========================================
// 2. LEAD SOURCES & MARKETING INTAKE
// ==========================================

enum LeadSourceType {
  FACEBOOK_ADS
  INSTAGRAM_ADS
  GOOGLE_ADS
  WEBSITE
  WHATSAPP
  MANUAL
  OTHER
}

model LeadSource {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique @db.VarChar(100)
  sourceType     LeadSourceType
  description    String?         @db.VarChar(500)
  apiKeyHash     String?         @db.VarChar(255)
  webhookSecret  String?         @db.VarChar(255)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  leads          Lead[]

  @@map("lead_sources")
}

// ==========================================
// 3. LEAD CORE & WORKFLOW
// ==========================================

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  FOLLOW_UP_REQUIRED
  INTERESTED
  NOT_INTERESTED
  INVALID_NUMBER
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  CONVERTED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Lead {
  id                   String           @id @default(uuid()) @db.Uuid
  leadCode             String           @unique @db.VarChar(50)
  customerName         String           @db.VarChar(150)
  phoneNumber          String           @db.VarChar(20)
  alternatePhone       String?          @db.VarChar(20)
  email                String?          @db.VarChar(255)
  city                 String?          @db.VarChar(100)
  state                String?          @db.VarChar(100)
  address              String?          @db.VarChar(500)
  productInterest      String?          @db.VarChar(255)
  customerRequirements String?          @db.Text
  notes                String?          @db.Text
  priority             LeadPriority     @default(NORMAL)
  status               LeadStatus       @default(NEW)
  
  sourceId             String?          @db.Uuid
  sourceType           LeadSourceType   @default(MANUAL)
  campaignId           String?          @db.VarChar(150)
  campaignName         String?          @db.VarChar(255)
  adSetId              String?          @db.VarChar(150)
  adId                 String?          @db.VarChar(150)
  externalLeadId       String?          @db.VarChar(150)
  costPerLead          Decimal?         @db.Decimal(10, 2)
  rawPayload           Json?

  createdById          String?          @db.Uuid
  assignedToId         String?          @db.Uuid
  assignedAt           DateTime?        @db.Timestamptz
  lastContactedAt      DateTime?        @db.Timestamptz
  convertedAt          DateTime?        @db.Timestamptz
  createdAt            DateTime         @default(now()) @db.Timestamptz
  updatedAt            DateTime         @updatedAt @db.Timestamptz

  source               LeadSource?      @relation(fields: [sourceId], references: [id])
  createdBy            User?            @relation("CreatedLeads", fields: [createdById], references: [id])
  assignedTo           User?            @relation("AssignedLeads", fields: [assignedToId], references: [id])
  
  assignments          LeadAssignment[]
  statusHistory        LeadStatusHistory[]
  callLogs             CallLog[]
  followUps            FollowUp[]
  pendingReviews       PendingReview[]
  approvalRequests     ApprovalRequest[]
  customer             Customer?

  @@index([phoneNumber])
  @@index([status, assignedToId])
  @@index([priority])
  @@index([createdAt])
  @@map("leads")
}

model LeadAssignment {
  id                  String    @id @default(uuid()) @db.Uuid
  leadId              String    @db.Uuid
  assignedById        String    @db.Uuid
  assignedToId        String    @db.Uuid
  reassignmentReason  String?   @db.VarChar(500)
  isActive            Boolean   @default(true)
  assignedAt          DateTime  @default(now()) @db.Timestamptz

  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedBy          User      @relation("AssignmentsGiven", fields: [assignedById], references: [id])
  assignedTo          User      @relation("AssignmentsReceived", fields: [assignedToId], references: [id])

  @@index([leadId, isActive])
  @@index([assignedToId])
  @@map("lead_assignments")
}

model LeadStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  leadId          String      @db.Uuid
  fromStatus      LeadStatus
  toStatus        LeadStatus
  changedById     String      @db.Uuid
  reason          String?     @db.VarChar(500)
  createdAt       DateTime    @default(now()) @db.Timestamptz

  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

// ==========================================
// 4. CALLING & FOLLOW-UPS
// ==========================================

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  NO_ANSWER
  BUSY_CALL_LATER
  INVALID_NUMBER
  FOLLOW_UP_REQUIRED
  PENDING_REVIEW
  REJECTED
}

model CallLog {
  id              String      @id @default(uuid()) @db.Uuid
  leadId          String      @db.Uuid
  callerId        String      @db.Uuid
  callOutcome     CallOutcome
  durationSeconds Int         @default(0)
  notes           String?     @db.Text
  calledAt        DateTime    @default(now()) @db.Timestamptz

  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  caller          User        @relation(fields: [callerId], references: [id])

  @@index([leadId, calledAt])
  @@index([callerId, calledAt])
  @@map("call_logs")
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  OVERDUE
}

model FollowUp {
  id              String         @id @default(uuid()) @db.Uuid
  leadId          String         @db.Uuid
  assignedToId    String         @db.Uuid
  scheduledTime   DateTime       @db.Timestamptz
  status          FollowUpStatus @default(SCHEDULED)
  reminderNotes   String?        @db.VarChar(500)
  completedAt     DateTime?      @db.Timestamptz
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo      User           @relation(fields: [assignedToId], references: [id])

  @@index([assignedToId, scheduledTime, status])
  @@index([leadId])
  @@map("follow_ups")
}

// ==========================================
// 5. PENDING REVIEW & APPROVALS
// ==========================================

enum PendingDecision {
  APPROVE
  REJECT
  REQUEST_FOLLOW_UP
  SEND_BACK
}

model PendingReview {
  id              String           @id @default(uuid()) @db.Uuid
  leadId          String           @db.Uuid
  submittedById   String           @db.Uuid
  claimedById     String?          @db.Uuid
  reason          String           @db.VarChar(255)
  salesNotes      String?          @db.Text
  reviewerNotes   String?          @db.Text
  decision        PendingDecision?
  decidedAt       DateTime?        @db.Timestamptz
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  claimedBy       User?            @relation("ReviewerPendingReviews", fields: [claimedById], references: [id])

  @@index([leadId])
  @@index([claimedById])
  @@map("pending_reviews")
}

enum ApprovalDecision {
  APPROVE
  REJECT
  SEND_BACK
}

model ApprovalRequest {
  id              String            @id @default(uuid()) @db.Uuid
  leadId          String            @db.Uuid
  officerId       String?           @db.Uuid
  decision        ApprovalDecision?
  decisionReason  String?           @db.VarChar(500)
  officerNotes    String?           @db.Text
  decidedAt       DateTime?         @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  officer         User?             @relation("OfficerApprovals", fields: [officerId], references: [id])

  @@index([leadId])
  @@index([officerId])
  @@map("approval_requests")
}

// ==========================================
// 6. CUSTOMER & PRODUCT CATALOG
// ==========================================

model Customer {
  id              String     @id @default(uuid()) @db.Uuid
  customerCode    String     @unique @db.VarChar(50)
  convertedFromId String?    @unique @db.Uuid
  fullName        String     @db.VarChar(150)
  phoneNumber     String     @unique @db.VarChar(20)
  alternatePhone  String?    @db.VarChar(20)
  email           String?    @db.VarChar(255)
  address         String?    @db.VarChar(500)
  city            String?    @db.VarChar(100)
  state           String?    @db.VarChar(100)
  pincode         String?    @db.VarChar(10)
  createdAt       DateTime   @default(now()) @db.Timestamptz
  updatedAt       DateTime   @updatedAt @db.Timestamptz

  convertedFrom   Lead?      @relation(fields: [convertedFromId], references: [id])
  orders          Order[]

  @@map("customers")
}

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  products    Product[]

  @@map("product_categories")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  sku         String           @unique @db.VarChar(50)
  name        String           @db.VarChar(200)
  categoryId  String           @db.Uuid
  description String?          @db.Text
  mrpPrice    Decimal          @db.Decimal(10, 2)
  sellingPrice Decimal         @db.Decimal(10, 2)
  gstRate     Decimal          @default(12.0) @db.Decimal(5, 2)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz

  category    ProductCategory  @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  inventory   Inventory?

  @@map("products")
}

// ==========================================
// 7. ORDERS, INVENTORY & DISPATCH
// ==========================================

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMode {
  CASH_ON_DELIVERY
  UPI
  NET_BANKING
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @db.VarChar(50)
  customerId      String        @db.Uuid
  createdById     String        @db.Uuid
  status          OrderStatus   @default(DRAFT)
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0.0) @db.Decimal(10, 2)
  taxAmount       Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentMode     PaymentMode   @default(CASH_ON_DELIVERY)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentRef      String?       @db.VarChar(100)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  customer        Customer      @relation(fields: [customerId], references: [id])
  createdBy       User          @relation("OrdersCreated", fields: [createdById], references: [id])
  items           OrderItem[]
  invoice         Invoice?
  shipment        Shipment?

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  productId   String   @db.Uuid
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Invoice {
  id            String    @id @default(uuid()) @db.Uuid
  invoiceNumber String    @unique @db.VarChar(50)
  orderId       String    @unique @db.Uuid
  cgstAmount    Decimal   @default(0.0) @db.Decimal(10, 2)
  sgstAmount    Decimal   @default(0.0) @db.Decimal(10, 2)
  igstAmount    Decimal   @default(0.0) @db.Decimal(10, 2)
  totalTax      Decimal   @db.Decimal(10, 2)
  grandTotal    Decimal   @db.Decimal(10, 2)
  issuedAt      DateTime  @default(now()) @db.Timestamptz

  order         Order     @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

model Inventory {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @unique @db.Uuid
  availableQuantity Int       @default(0)
  reservedQuantity  Int       @default(0)
  lowStockThreshold Int       @default(20)
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  product           Product   @relation(fields: [productId], references: [id])
  transactions      InventoryTransaction[]

  @@map("inventory")
}

enum InventoryTxType {
  RESTOCK
  ORDER_RESERVATION
  ORDER_FULFILLED
  ORDER_CANCELLED
  ADJUSTMENT
}

model InventoryTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  inventoryId String          @db.Uuid
  type        InventoryTxType
  quantity    Int
  balanceAfter Int
  notes       String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @db.Timestamptz

  inventory   Inventory       @relation(fields: [inventoryId], references: [id])

  @@map("inventory_transactions")
}

enum ShipmentStatus {
  MANIFESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
}

model Shipment {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @unique @db.Uuid
  courierPartner  String         @db.VarChar(100)
  trackingAwb     String         @unique @db.VarChar(100)
  trackingUrl     String?        @db.VarChar(500)
  status          ShipmentStatus @default(MANIFESTED)
  dispatchedAt    DateTime?      @db.Timestamptz
  deliveredAt     DateTime?      @db.Timestamptz
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  order           Order          @relation(fields: [orderId], references: [id])

  @@map("shipments")
}

// ==========================================
// 8. AUDIT LOGGING & SYSTEM MONITORING
// ==========================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  oldState   Json?
  newState   Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @db.Timestamptz

  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
