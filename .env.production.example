# ==============================================================================
# MELAYURVEDA CRM - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# MELAYURVEDA INDIA PVT. LTD. - ENTERPRISE AYURVEDIC CRM
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4100
API_PREFIX=/api/v1

# Gateway & Public URL
CORS_ORIGIN=https://crm.melayurveda.com
NEXT_PUBLIC_API_URL=https://crm.melayurveda.com/api/v1
NEXT_PUBLIC_APP_NAME="Melayurveda CRM"
NEXT_PUBLIC_COMPANY_NAME="MELAYURVEDA INDIA PVT. LTD."

# Production PostgreSQL Database
POSTGRES_USER=melayurveda_prod_user
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_64_CHARS
POSTGRES_DB=melayurveda_crm_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Prisma Connection URL with Connection Pool Tuning
DATABASE_URL=postgresql://melayurveda_prod_user:GENERATE_STRONG_RANDOM_PASSWORD_64_CHARS@postgres:5432/melayurveda_crm_prod?schema=public&connection_limit=20&pool_timeout=30

# Authentication & Cryptographic Secrets (Use: openssl rand -base64 64)
JWT_ACCESS_SECRET=GENERATE_PRODUCTION_JWT_ACCESS_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=GENERATE_PRODUCTION_JWT_REFRESH_SECRET_MIN_64_CHARS
JWT_REFRESH_EXPIRATION=7d

# Hardened Cookies (HTTPS Required)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Initial Super Admin (Seeded on first deployment)
INITIAL_ADMIN_EMAIL=admin@melayurveda.com
INITIAL_ADMIN_PASSWORD=GENERATE_INITIAL_ADMIN_COMPLEX_PASSWORD_2026!
INITIAL_ADMIN_FIRST_NAME=Super
INITIAL_ADMIN_LAST_NAME=Admin
INITIAL_ADMIN_PHONE=9876543210
